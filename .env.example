# Copy to .env and fill in.
# Local: docker compose up -d --build
# VPS:   docker compose -f compose.vps.yaml up -d --build

# Basic Auth username (optional; if empty, any username is accepted with the password)
DECKPRESS_USER=tomas

# Scrypt password hash from `npm run hash-password`, the .env line.
# Keep the single quotes: without them Compose expands the $ signs in the hash.
# Leave empty for passwordless local development.
DECKPRESS_PASSWORD_HASH=''

# Local compose.yaml port & host data directory
PORT=8080
DECKPRESS_DATA_HOST_DIR=~/data/deckpress

# VPS compose.vps.yaml settings (caddy-docker-proxy + homepage)
DECKPRESS_DOMAIN=deckpress.hutnan.dev
DECKPRESS_DATA_PATH=/home/deploy/data/deckpress
# Optional image tag pin for GHCR
# DECKPRESS_IMAGE_TAG=latest
